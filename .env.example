# Copy this file to .env and fill in your values
# Used by docker-compose.yml at the project root

MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/fixfirst?retryWrites=true&w=majority
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRE=30d

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Leave empty for AI mock mode
OPENAI_API_KEY=
